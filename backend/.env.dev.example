# JWT Secret
JWT_SECRET=SECRET

# Auth
# Postgres
AUTH_POSTGRES_USER=postgres  # Database user
AUTH_POSTGRES_PASSWORD=pass  # Database password
AUTH_POSTGRES_HOST=localhost # Database host
AUTH_POSTGRES_PORT=5432      # Database port
AUTH_POSTGRES_DB=user_db     # Database name

# Pin
# Postgres
PIN_POSTGRES_USER=postgres          # Database user
PIN_POSTGRES_PASSWORD=pass          # Database password
PIN_POSTGRES_HOST=localhost         # Database host
PIN_POSTGRES_PORT=5433              # Database port
PIN_POSTGRES_DB=pin_db              # Database name

# Garage (S3-compatible)
GARAGE_USER=minioadmin
GARAGE_PASSWORD=minioadmin12345678
GARAGE_BUCKET=pins
GARAGE_ENDPOINT=localhost:9000
GARAGE_USE_SSL=false

# Background cleanup of abandoned pending uploads
PIN_CLEANUP_INTERVAL=10m
PIN_CLEANUP_TTL=60m
PIN_CLEANUP_BATCH_SIZE=100

# Interaction
# Postgres
INTERACTION_POSTGRES_USER=postgres          # Database user
INTERACTION_POSTGRES_PASSWORD=pass          # Database password
INTERACTION_POSTGRES_HOST=localhost         # Database host
INTERACTION_POSTGRES_PORT=5434              # Database port
INTERACTION_POSTGRES_DB=interaction_db      # Database name

# Redis
REDIS_PASSWORD=pass
REDIS_ADDR=localhost:6379

# Ports & hosts
GATEWAY_PORT=8080
AUTH_PORT=8081
PIN_PORT=8082
INTERACTION_PORT=8083

GATEWAY_HOST=localhost
AUTH_HOST=localhost
PIN_HOST=localhost
INTERACTION_HOST=localhost

# Seed
SEED_USER_EMAIL=seed@example.com
SEED_USER_PASSWORD=SeedPassword123!
