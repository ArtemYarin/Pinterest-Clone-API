# JWT Secret
JWT_SECRET=CHANGE_TO_YOUR_SECRET_KEY_AT_LEAST_32_BYTES

# Postgres pins
POSTGRES_USER=postgres  # Database user
POSTGRES_PASSWORD=pass  # Database password
POSTGRES_HOST=localhost # Database host
POSTGRES_PORT=5433      # Database port 5433 for local development 5432 for production
POSTGRES_DB=pin_db      # Database name

# Garage (S3-compatible)
GARAGE_INTERNAL_ENDPOINT=localhost:3900
GARAGE_PUBLIC_ENDPOINT=localhost:3900
GARAGE_USER=minioadmin
GARAGE_PASSWORD=minioadmin12345678
GARAGE_BUCKET=pins
GARAGE_USE_SSL=false

# Port this service listens on
PIN_PORT=8082

# Port for internal gRPC server
PIN_GRPC_PORT=9082

# Background cleanup of abandoned pending uploads
PIN_CLEANUP_INTERVAL=10m
PIN_CLEANUP_TTL=60m
PIN_CLEANUP_BATCH_SIZE=100

# Redis read cache
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=pass
PIN_CACHE_TTL=5m       # single pin
PIN_CACHE_LIST_TTL=1m  # pin lists
PIN_CACHE_NOT_FOUND_TTL=30s  # cached "pin not found" lookups