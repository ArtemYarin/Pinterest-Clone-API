# JWT Secret
JWT_SECRET=SECRET

# Postgres profiles
POSTGRES_USER=postgres  # Database user
POSTGRES_PASSWORD=pass  # Database password
POSTGRES_HOST=localhost # Database host
POSTGRES_PORT=5435      # Database port
POSTGRES_DB=profile_db  # Database name

# Garage (S3-compatible) - shared "pins" bucket, avatars live under an avatars/ prefix
GARAGE_INTERNAL_ENDPOINT=localhost:3900
GARAGE_PUBLIC_ENDPOINT=localhost:3900
GARAGE_USER=minioadmin
GARAGE_PASSWORD=minioadmin12345678
GARAGE_BUCKET=pins
GARAGE_USE_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Port this service listens on
PROFILE_PORT=8084
