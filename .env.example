# JWT Secret
JWT_SECRET=CHANGE_TO_YOUR_SECRET_KEY_AT_LEAST_32_BYTES

# Auth
# Postgres
AUTH_POSTGRES_USER=postgres      # Database user
AUTH_POSTGRES_PASSWORD=pass      # Database password
AUTH_POSTGRES_HOST=postgres-auth # Database host
AUTH_POSTGRES_PORT=5432          # Database port
AUTH_POSTGRES_DB=user_db         # Database name

# Pin
# Postgres
PIN_POSTGRES_USER=postgres          # Database user
PIN_POSTGRES_PASSWORD=pass          # Database password
PIN_POSTGRES_HOST=postgres-pin      # Database host
PIN_POSTGRES_PORT=5432              # Database port
PIN_POSTGRES_DB=pin_db              # Database name

# Garage (S3-compatible)
GARAGE_USER=minioadmin
GARAGE_PASSWORD=minioadmin12345678
GARAGE_BUCKET=pins
GARAGE_INTERNAL_ENDPOINT=garage:3900
GARAGE_PUBLIC_ENDPOINT=localhost:3900
GARAGE_USE_SSL=false
# Comma-separated origins allowed to upload to presigned URLs (default: *)
GARAGE_CORS_ORIGINS=

# Background cleanup of abandoned pending uploads
PIN_CLEANUP_INTERVAL=10m
PIN_CLEANUP_TTL=60m
PIN_CLEANUP_BATCH_SIZE=100

# Interaction
# Postgres
INTERACTION_POSTGRES_USER=postgres          # Database user
INTERACTION_POSTGRES_PASSWORD=pass          # Database password
INTERACTION_POSTGRES_HOST=postgres-interaction # Database host
INTERACTION_POSTGRES_PORT=5432              # Database port
INTERACTION_POSTGRES_DB=interaction_db      # Database name

# Redis
REDIS_PASSWORD=pass
REDIS_ADDR=redis:6379

# Profile
# Postgres
PROFILE_POSTGRES_USER=postgres          # Database user
PROFILE_POSTGRES_PASSWORD=pass          # Database password
PROFILE_POSTGRES_HOST=postgres-profile  # Database host
PROFILE_POSTGRES_PORT=5432              # Database port
PROFILE_POSTGRES_DB=profile_db          # Database name

# RabbitMQ (auth -> profile registration events)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Ports & hosts
GATEWAY_PORT=8080
AUTH_PORT=8080
PIN_PORT=8080
INTERACTION_PORT=8080
PROFILE_PORT=8080

# Internal gRPC ports (gateway -> services)
PIN_GRPC_PORT=9090
INTERACTION_GRPC_PORT=9090

GATEWAY_HOST=gateway
AUTH_HOST=auth-api
PIN_HOST=pin-api
INTERACTION_HOST=interaction-api
PROFILE_HOST=profile-api

# Seed
SEED_USER_EMAIL=seed@example.com
SEED_USER_PASSWORD=SeedPassword123!

# Frontend
VITE_API_PORT=8080
VITE_API_HOST=gateway
