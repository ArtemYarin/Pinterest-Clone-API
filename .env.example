# JWT Secret
JWT_SECRET=SECRET

# Auth
# Postgres
AUTH_POSTGRES_USER=postgres      # Database user
AUTH_POSTGRES_PASSWORD=pass      # Database password
AUTH_POSTGRES_HOST=postgres-auth # Database host
AUTH_POSTGRES_PORT=5432          # Database port
AUTH_POSTGRES_DB=user_db         # Database name

# Pin
# Postgres
PIN_POSTGRES_USER=postgres          # Database user
PIN_POSTGRES_PASSWORD=pass          # Database password
PIN_POSTGRES_HOST=postgres-pin      # Database host
PIN_POSTGRES_PORT=5432              # Database port
PIN_POSTGRES_DB=pin_db              # Database name

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_BUCKET=pins
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# Background cleanup of abandoned pending uploads
PIN_CLEANUP_INTERVAL=10m
PIN_CLEANUP_TTL=60m
PIN_CLEANUP_BATCH_SIZE=100

# Interaction
# Postgres
INTERACTION_POSTGRES_USER=postgres          # Database user
INTERACTION_POSTGRES_PASSWORD=pass          # Database password
INTERACTION_POSTGRES_HOST=postgres-interaction # Database host
INTERACTION_POSTGRES_PORT=5432              # Database port
INTERACTION_POSTGRES_DB=interaction_db      # Database name

# Redis
REDIS_PASSWORD=pass
REDIS_ADDR=redis:6379

# Ports & hosts
GATEWAY_PORT=8080
AUTH_PORT=8080
PIN_PORT=8080
INTERACTION_PORT=8080

GATEWAY_HOST=gateway
AUTH_HOST=auth-api
PIN_HOST=pin-api
INTERACTION_HOST=interaction-api
